{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnactusNG",
  "version": "1.0.0",
  "identifier": "ng.enactus.admin",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "title": "Enactus Nigeria – Admin",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#18130E"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Enactus Nigeria admin dashboard",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
